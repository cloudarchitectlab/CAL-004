graph TB

    Internet["Internet / Users"]
    TrustedAdmin["Trusted Administrator<br/>Configured CIDR"]

    subgraph Account["AWS Account"]

        subgraph Region["Region: AWS_REGION"]

            subgraph VPC["VPC: VPC_CIDR"]

                IGW["Internet Gateway"]

                subgraph AZ["Availability Zone: AVAILABILITY_ZONE"]

                    subgraph PublicSubnet["Public Subnet: PUBLIC_SUBNET_CIDR"]

                        PublicRT["Public Route Table<br/>VPC_CIDR → local<br/>0.0.0.0/0 → Internet Gateway"]

                        PublicSG["Public Security Group<br/>Inbound: HTTP 80 from Internet<br/>Inbound: HTTPS 443 from Internet<br/>Inbound: SSH 22 from Trusted CIDR<br/>Outbound: All"]

                    end

                    subgraph PrivateSubnet["Private Subnet: PRIVATE_SUBNET_CIDR"]

                        PrivateRT["Private Route Table<br/>VPC_CIDR → local<br/>No Internet default route"]

                        PrivateSG["Private Security Group<br/>Inbound: TCP 8080 from Public Security Group<br/>Outbound: All"]

                    end

                end

            end

        end

    end

    Internet --> IGW
    PublicRT -->|"0.0.0.0/0"| IGW

    Internet -.->|"HTTP 80 / HTTPS 443 allowed"| PublicSG
    TrustedAdmin -.->|"SSH 22 allowed"| PublicSG
    PublicSG -.->|"TCP 8080 allowed"| PrivateSG

    classDef account stroke:#818cf8,fill:#eef2ff
    classDef region stroke:#818cf8,fill:#eef2ff
    classDef vpc stroke:#2dd4bf,fill:#f0fdfa
    classDef az stroke:#38bdf8,fill:#f0f9ff
